# Sunucu ayarları. Gerçek değerler .env dosyasında durur, depoya yazılmaz.

NODE_ENV=development
PORT=3000
# Varsayılan yalnızca bu bilgisayar. Yayına alırken bilinçli olarak değiştir.
HOST=127.0.0.1

# En az 32 karakter, rastgele üret:  openssl rand -base64 48
JWT_SECRET=
# İlk hesabı (platform sahibi) oluşturmak için tek seferlik, en az 24 karakter:  openssl rand -base64 32
BOOTSTRAP_TOKEN=

# Sunucu ayarları. Gerçek değerler .env dosyasında durur, depoya yazılmaz.

NODE_ENV=development
PORT=3000
# Varsayılan yalnızca bu bilgisayar. Tailscale/ev ağı için bilinçli olarak değiştir.
HOST=127.0.0.1

# En az 32 karakter, rastgele üret:  openssl rand -base64 48
JWT_SECRET=
# İlk owner hesabını oluşturmak için tek seferlik, en az 24 karakter:  openssl rand -base64 32
BOOTSTRAP_TOKEN=

# Home Assistant (isteğe bağlı, yoksa komutlar sahte istemciye gider)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
